rules_version = '2';

// Auto-deployed by .github/workflows/firebase-backend.yml on every push to main
// that touches this file, after tests/rules passes against the emulator.
//
// Data model
//   candidates/{uid}              a signed-up user's leaderboard entry (doc id == Auth uid)
//   votes/{voterUid}_{candidateId} one voter's history with one candidate:
//                                 { season, ups, downs (this season), weekAt, weekKind }
//                                 one vote a week per person: weekAt starts the week, weekKind is this
//                                 week's vote ('up' | 'down' | 'none'); it can be changed or cancelled
//                                 until the week is over, then a new week's vote can be cast (votes add up)
//   meta/season                   { name, number, startedAt, last?, endsAt?, rewards? }
//                                 last = the ended season's { name, top: [≤3 × {id,name,score,frame}] }
//                                 endsAt = when the worker ends the season automatically (paying rewards)
//                                 rewards = { first, second, third, top6, participant } points
//   seasonResults/{number}        what each season paid out (written by the worker / admin reset)
//   gifts/{id}                    포인트 선물 in a chat { chatId, from, to (1:1) | null (group: first to tap), amount, status }
//                                 the sender's points are held (spent += amount) until claimed or cancelled
//   meta/adminLock                the admin operation currently being committed (see below)
//   adminTokens/{random id}       single-use tokens for admin operations
//   banned/{uid}                  accounts deleted by the admin; they can't re-join
//   chats/{chatId}                1:1 (id = sorted uids joined by '_') or group chat (≤10 members);
//                                 reads/mutes maps hold each member's read time / 알림 off
//   chats/{chatId}/messages/{id}  { uid, text, at }
//   pushTokens/{token}            one device's push token { uid, token, platform, updatedAt }
//   settings/{uid}                private notification settings { notify, notifyMsg, notifyVote }
//   meta/notifyCursor             the notification sender's progress (service account only)
//   support/{uid}                 a 상담 (support chat) with the admin; uid may be an anonymous login
//   support/{uid}/messages/{id}   { from: 'user'|'admin', text, at }
//   pwResets/{uid}                admin password reset: one-time code the worker sets as the password
//   notices/{id}                  admin 공지 { title, body, by, createdAt } — each signed-in person can read it once
//   meta/noticeIndex              { ids: [newest first, ≤ 20] } so the app knows which notices exist
//   noticeReads/{uid}             { seen: { noticeId: true } } — only ever grows; a seen notice can't be read again
//
// Admin operations (grant points, set season name, reset season, delete account)
// Only the admin account (id "admin", i.e. admin@vote.local, or a user with the
// `admin` custom claim that only a service account can set) may run them, and
// every batch of writes must:
//   1. burn three fresh single-use tokens (seq 1, 2, 3) that the admin created
//      within the last 2 minutes for exactly this action + payload, and
//   2. write meta/adminLock with those token ids in the same batch.
// The lock rule checks the three tokens; every privileged write checks that the
// lock was written in this very request (lock.at == request.time) for its action.
// A token can't be reused (used only goes false → true, never deleted), so
// replaying or tampering with a request fails.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (request.auth.token.email == 'admin@vote.local' || request.auth.token.get('admin', false) == true);
    }

    // ---- admin operation plumbing -------------------------------------------------

    function lockPath() { return /databases/$(database)/documents/meta/adminLock; }
    function lock() { return getAfter(lockPath()).data; }
    // True only inside the batch that just wrote a valid meta/adminLock for `action`.
    function adminOp(action) {
      return isAdmin() && lock().at == request.time && lock().by == request.auth.uid && lock().action == action;
    }

    function validPersonName(n) { return n is string && n.size() >= 1 && n.size() <= 20; }

    function rewardOk(n) { return n is int && n >= 0 && n <= 100000; }

    function validPayload(action, p) {
      return (action == 'grantPoints' && p.keys().hasOnly(['target', 'amount']) && p.keys().hasAll(['target', 'amount'])
                && p.target is string && p.amount is int && p.amount != 0 && p.amount >= -1000000 && p.amount <= 1000000)
          || (action == 'setSeasonName' && p.keys().hasOnly(['name']) && validSeasonName(p.name))
          || (action == 'seasonReset' && p.keys().hasOnly(['name', 'nextNumber']) && p.keys().hasAll(['name', 'nextNumber'])
                && validSeasonName(p.name) && p.nextNumber is int)
          || (action == 'renameUser' && p.keys().hasOnly(['target', 'name']) && p.keys().hasAll(['target', 'name'])
                && p.target is string && validPersonName(p.name))
          || (action == 'resetPassword' && p.keys().hasOnly(['target', 'code']) && p.keys().hasAll(['target', 'code'])
                && p.target is string && p.code is string && p.code.matches('[0-9]{8}'))
          || (action == 'postNotice' && p.keys().hasOnly(['id', 'title', 'body']) && p.keys().hasAll(['id', 'title', 'body'])
                && p.id is string && p.id.matches('[A-Za-z0-9]{20}')
                && p.title is string && p.title.size() >= 1 && p.title.size() <= 40
                && p.body is string && p.body.size() >= 1 && p.body.size() <= 2000)
          || (action == 'seasonConfig' && p.keys().hasOnly(['endsAt', 'first', 'second', 'third', 'top6', 'participant'])
                && p.keys().hasAll(['endsAt', 'first', 'second', 'third', 'top6', 'participant'])
                && p.endsAt is int && p.endsAt >= 0
                && rewardOk(p.first) && rewardOk(p.second) && rewardOk(p.third) && rewardOk(p.top6) && rewardOk(p.participant))
          || (action == 'deleteAccount' && p.keys().hasOnly(['target']) && p.target is string && p.target != request.auth.uid);
    }
    function validSeasonName(n) { return n is string && n.size() >= 1 && n.size() <= 20; }

    function tokenOk(id, seq) {
      let p = /databases/$(database)/documents/adminTokens/$(id);
      let before = get(p).data;
      let l = request.resource.data;
      return before.used == false && getAfter(p).data.used == true
        && before.uid == request.auth.uid && before.seq == seq
        && before.action == l.action && before.payload == l.payload
        && request.time < before.createdAt + duration.value(120, 's');
    }

    match /meta/adminLock {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['by', 'action', 'payload', 'tokens', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.tokens is list && request.resource.data.tokens.size() == 3
        && validPayload(request.resource.data.action, request.resource.data.payload)
        && tokenOk(request.resource.data.tokens[0], 1)
        && tokenOk(request.resource.data.tokens[1], 2)
        && tokenOk(request.resource.data.tokens[2], 3);
      allow delete: if false;
    }

    match /adminTokens/{tokenId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && tokenId.size() >= 32
        && request.resource.data.keys().hasOnly(['uid', 'action', 'payload', 'seq', 'used', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.used == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.seq in [1, 2, 3]
        && request.resource.data.action in ['grantPoints', 'setSeasonName', 'seasonReset', 'deleteAccount', 'renameUser', 'resetPassword', 'postNotice', 'seasonConfig']
        && request.resource.data.payload is map;
      // Burned only together with a lock that lists it.
      allow update: if isAdmin()
        && resource.data.uid == request.auth.uid
        && resource.data.used == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
        && request.resource.data.used == true
        && lock().at == request.time
        && tokenId in lock().tokens;
      allow delete: if false;
    }

    // ---- season -------------------------------------------------------------------

    // The ended season's podium, recorded by the reset so the app can show it once.
    function lastOk(last, endedName) {
      return last == null || (last is map && last.keys().hasOnly(['name', 'top']) && last.name == endedName
        && last.top is list && last.top.size() <= 3);
    }

    match /meta/season {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['name', 'number', 'startedAt', 'last', 'endsAt', 'rewards']) && (
        (adminOp('setSeasonName')
          && request.resource.data.name == lock().payload.name
          && request.resource.data.get('last', null) == (resource == null ? null : resource.data.get('last', null))
          && request.resource.data.get('endsAt', null) == (resource == null ? null : resource.data.get('endsAt', null))
          && request.resource.data.get('rewards', null) == (resource == null ? null : resource.data.get('rewards', null))
          && (resource == null
                ? request.resource.data.number == 1 && request.resource.data.startedAt == request.time
                : request.resource.data.number == resource.data.number && request.resource.data.startedAt == resource.data.startedAt)) ||
        (adminOp('seasonReset')
          && request.resource.data.name == lock().payload.name
          && request.resource.data.number == lock().payload.nextNumber
          && lock().payload.nextNumber == (resource == null ? 1 : resource.data.number) + 1
          && request.resource.data.startedAt == request.time
          && lastOk(request.resource.data.get('last', null), resource == null ? 'BETA' : resource.data.name)
          && !('endsAt' in request.resource.data)
          && request.resource.data.get('rewards', null) == (resource == null ? null : resource.data.get('rewards', null))) ||
        // End date and rewards; everything else stays.
        (adminOp('seasonConfig')
          && (resource == null
                ? request.resource.data.name == 'BETA' && request.resource.data.number == 1 && request.resource.data.startedAt == request.time
                : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endsAt', 'rewards']))
          && request.resource.data.get('endsAt', null) == (lock().payload.endsAt == 0 ? null : timestamp.value(lock().payload.endsAt))
          && request.resource.data.rewards == {'first': lock().payload.first, 'second': lock().payload.second, 'third': lock().payload.third,
                                               'top6': lock().payload.top6, 'participant': lock().payload.participant})
      );
    }

    // ---- candidates ---------------------------------------------------------------

    function photoOk(d) { return d.photoURL is string && d.photoURL.size() < 300000; }

    function price(kind, k) {
      let frame = {'neon': 60, 'crown': 90, 'sakura': 50, 'cat': 50, 'stars': 70, 'flame': 80, 'ocean': 60, 'bunny': 50, 'halo': 75, 'devil': 75, 'butterfly': 60};
      let skin = {'namsan': 100, 'eiffel': 125, 'bigben': 125, 'victory': 110};
      return kind == 'frame' ? frame.get(k, 0) : kind == 'plate' ? frame.get(k, 0) + 15 : skin.get(k, 0);
    }
    function buyable(kind, added) {
      let frameKeys = ['neon', 'crown', 'sakura', 'cat', 'stars', 'flame', 'ocean', 'bunny', 'halo', 'devil', 'butterfly'];
      let skinKeys = ['namsan', 'eiffel', 'bigben', 'victory'];
      return added.size() == 0 || (added.size() == 1 && added[0] in (kind == 'skin' ? skinKeys : frameKeys));
    }
    function costOf(kind, added) { return added.size() == 1 ? price(kind, added[0]) : 0; }

    // Owner editing their own profile, equipping, or buying one item at its real price.
    function ownerEdit() {
      let d = request.resource.data;
      let o = resource.data;
      let addF = d.owned.frame.removeAll(o.owned.frame);
      let addP = d.owned.plate.removeAll(o.owned.plate);
      let addS = d.owned.skin.removeAll(o.owned.skin);
      let cost = costOf('frame', addF) + costOf('plate', addP) + costOf('skin', addS);
      return request.auth.uid == o.ownerUid
        && d.diff(o).affectedKeys().hasOnly(['gender', 'bio', 'photoURL', 'frame', 'plate', 'skin', 'spent', 'owned', 'msgOff'])
        && d.owned.keys().hasOnly(['frame', 'plate', 'skin'])
        && d.owned.frame.hasAll(o.owned.frame) && d.owned.plate.hasAll(o.owned.plate) && d.owned.skin.hasAll(o.owned.skin)
        && addF.size() + addP.size() + addS.size() <= 1
        && buyable('frame', addF) && buyable('plate', addP) && buyable('skin', addS)
        && d.spent == o.spent + cost
        && (cost == 0 || d.spent <= d.up + d.get('bonus', 0))
        && d.frame in d.owned.frame && d.plate in d.owned.plate && d.skin in d.owned.skin
        && d.bio is string && d.bio.size() <= 60
        && d.gender in ['', '남자', '여자']
        && d.get('msgOff', false) is bool
        && photoOk(d);
    }

    // ---- vote bookkeeping ----
    // A vote doc counts toward the tally only for the season it was last updated in;
    // a season reset zeroes the tallies but keeps the docs (so the 7-day timer and the
    // one-time 비추천 carry over).
    function curSeason() {
      let sp = /databases/$(database)/documents/meta/season;
      return exists(sp) ? get(sp).data.number : 1;
    }
    function upsNow(v, cur) { return v.get('season', 0) == cur ? v.get('ups', 0) : 0; }
    function downsNow(v, cur) { return v.get('season', 0) == cur ? v.get('downs', 0) : 0; }

    // ---- 포인트 선물 (gifts): the candidate side of each step names the gift in lastGift ----
    function giftPath(id) { return /databases/$(database)/documents/gifts/$(id); }
    // Sending: the points leave (spent grows by the gift amount), as long as I have them.
    function giftSend() {
      let d = request.resource.data;
      let o = resource.data;
      let g = getAfter(giftPath(d.lastGift)).data;
      return request.auth.uid == o.ownerUid
        && d.diff(o).affectedKeys().hasOnly(['spent', 'lastGift'])
        && !exists(giftPath(d.lastGift))
        && g.from == request.auth.uid && g.status == 'open'
        && d.spent == o.spent + g.amount
        && d.spent <= d.up + d.get('bonus', 0);
    }
    // Claiming: the points arrive as bonus.
    function giftClaim() {
      let d = request.resource.data;
      let o = resource.data;
      let g0 = get(giftPath(d.lastGift)).data;
      let g1 = getAfter(giftPath(d.lastGift)).data;
      return request.auth.uid == o.ownerUid
        && d.diff(o).affectedKeys().hasOnly(['bonus', 'lastGift'])
        && g0.status == 'open' && g1.status == 'claimed' && g1.claimedBy == request.auth.uid
        && d.bonus == o.get('bonus', 0) + g0.amount;
    }
    // Cancelling an unclaimed gift: the held points come back.
    function giftCancel() {
      let d = request.resource.data;
      let o = resource.data;
      let g0 = get(giftPath(d.lastGift)).data;
      let g1 = getAfter(giftPath(d.lastGift)).data;
      return request.auth.uid == o.ownerUid
        && d.diff(o).affectedKeys().hasOnly(['spent', 'lastGift'])
        && g0.from == request.auth.uid && g0.status == 'open' && g1.status == 'cancelled'
        && d.spent == o.spent - g0.amount;
    }

    // 300P once per account for opening the installed app.
    function appBonusClaim() {
      let d = request.resource.data;
      let o = resource.data;
      return request.auth.uid == o.ownerUid
        && d.diff(o).affectedKeys().hasOnly(['appBonus', 'bonus'])
        && o.get('appBonus', false) == false && d.appBonus == true
        && d.bonus == o.get('bonus', 0) + 300;
    }
    // The login id (shown on profiles): set once, and only to the owner's own id.
    function ownLoginId(v) { return v is string && request.auth.token.email == v + '@vote.local'; }
    function loginIdBackfill() {
      let d = request.resource.data;
      return request.auth.uid == resource.data.ownerUid
        && !('loginId' in resource.data)
        && d.diff(resource.data).affectedKeys().hasOnly(['loginId'])
        && ownLoginId(d.loginId);
    }

    // Another user's vote moving the tally — must match their vote doc changing in the same write.
    function voteTally(candidateId) {
      let d = request.resource.data;
      let o = resource.data;
      let vp = /databases/$(database)/documents/votes/$(request.auth.uid + '_' + candidateId);
      let before = exists(vp) ? get(vp).data : {};
      let cur = curSeason();
      return request.auth.uid != o.ownerUid
        && existsAfter(vp)
        && d.diff(o).affectedKeys().hasOnly(['up', 'down', 'score'])
        && d.up == o.up + upsNow(getAfter(vp).data, cur) - upsNow(before, cur)
        && d.down == o.down + downsNow(getAfter(vp).data, cur) - downsNow(before, cur)
        && (d.up != o.up || d.down != o.down)
        && d.score == d.up - d.down;
    }

    function adminGrant(candidateId) {
      let d = request.resource.data;
      return adminOp('grantPoints') && lock().payload.target == candidateId
        && d.diff(resource.data).affectedKeys().hasOnly(['bonus'])
        && d.bonus == resource.data.get('bonus', 0) + lock().payload.amount;
    }

    function adminRename(candidateId) {
      let d = request.resource.data;
      return adminOp('renameUser') && lock().payload.target == candidateId
        && d.diff(resource.data).affectedKeys().hasOnly(['name'])
        && d.name == lock().payload.name;
    }

    // Season reset: tallies to zero; this season's recommendations carry over as points (bonus).
    function adminSeasonReset() {
      let d = request.resource.data;
      let o = resource.data;
      return adminOp('seasonReset')
        && d.diff(o).affectedKeys().hasOnly(['up', 'down', 'score', 'bonus'])
        && d.up == 0 && d.down == 0 && d.score == 0
        // This season's 추천 carry over as points, plus the season reward (rank + taking part), at most 1st + participant.
        && d.get('bonus', 0) >= o.get('bonus', 0) + o.up
        && d.get('bonus', 0) <= o.get('bonus', 0) + o.up + maxReward();
    }
    function maxReward() {
      let sp = /databases/$(database)/documents/meta/season;
      let r = exists(sp) ? get(sp).data.get('rewards', null) : null;
      return r == null ? 550 : r.first + r.participant;
    }

    // Deleting account T: take back T's vote on this candidate, deleting that vote doc in the same batch.
    function adminDeleteAdjust(candidateId) {
      let d = request.resource.data;
      let o = resource.data;
      let target = lock().payload.target;
      let vp = /databases/$(database)/documents/votes/$(target + '_' + candidateId);
      let v = get(vp).data;
      let cur = curSeason();
      return adminOp('deleteAccount') && candidateId != target
        && !existsAfter(vp)
        && d.diff(o).affectedKeys().hasOnly(['up', 'down', 'score'])
        && d.up == o.up - upsNow(v, cur)
        && d.down == o.down - downsNow(v, cur)
        && d.score == d.up - d.down;
    }

    match /candidates/{candidateId} {
      allow read: if true;

      allow create: if signedIn()
        && request.auth.uid == candidateId
        && !exists(/databases/$(database)/documents/banned/$(candidateId))
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'up', 'down', 'score', 'gender', 'bio', 'photoURL', 'frame', 'plate', 'skin', 'spent', 'owned', 'createdAt', 'loginId'])
        && (!('loginId' in request.resource.data) || ownLoginId(request.resource.data.loginId))
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 20
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.up == 0 && request.resource.data.down == 0 && request.resource.data.score == 0
        && request.resource.data.spent == 0
        && request.resource.data.gender == '' && request.resource.data.bio == '' && request.resource.data.photoURL == ''
        && request.resource.data.frame == 'none' && request.resource.data.plate == 'none' && request.resource.data.skin == 'none'
        && request.resource.data.owned == {'frame': ['none'], 'plate': ['none'], 'skin': ['none']};

      allow update: if signedIn() && (
        ownerEdit() || voteTally(candidateId) || appBonusClaim() || loginIdBackfill() || giftSend() || giftClaim() || giftCancel() ||
        adminGrant(candidateId) || adminRename(candidateId) || adminSeasonReset() || adminDeleteAdjust(candidateId)
      );

      allow delete: if adminOp('deleteAccount') && lock().payload.target == candidateId;
    }

    // ---- votes --------------------------------------------------------------------

    // The vote doc may only change together with the matching tally change on the candidate.
    function voteMatchesTally() {
      let cp = /databases/$(database)/documents/candidates/$(request.resource.data.candidateId);
      let c0 = get(cp).data;
      let c1 = getAfter(cp).data;
      let o = resource == null ? {} : resource.data;
      let cur = curSeason();
      return c0.ownerUid != request.auth.uid
        && c1.up == c0.up + upsNow(request.resource.data, cur) - upsNow(o, cur)
        && c1.down == c0.down + downsNow(request.resource.data, cur) - downsNow(o, cur);
    }

    // One vote a week per person. Within the week it can be switched (추천 ⇄ 비추천) or cancelled;
    // after the week, a new vote starts a new week. The tally moves by exactly the difference.
    function voteAction() {
      let d = request.resource.data;
      let o = resource == null ? {} : resource.data;
      let cur = curSeason();
      let oUps = upsNow(o, cur);
      let oDowns = downsNow(o, cur);
      let oWeekAt = o.get('weekAt', null);
      let oKind = o.get('weekKind', 'none');
      let inWeek = oWeekAt != null && request.time < oWeekAt + duration.value(7, 'd');
      let up = d.weekKind == 'up' ? 1 : 0;
      let down = d.weekKind == 'down' ? 1 : 0;
      return d.season == cur && d.ups is int && d.downs is int && d.weekKind in ['up', 'down', 'none']
        && (inWeek
          ? (o.get('season', 0) == cur && d.weekAt == oWeekAt && d.weekKind != oKind
              && d.ups == oUps + up - (oKind == 'up' ? 1 : 0)
              && d.downs == oDowns + down - (oKind == 'down' ? 1 : 0))
          : (d.weekKind in ['up', 'down'] && d.weekAt == request.time
              && d.ups == oUps + up && d.downs == oDowns + down));
    }

    match /votes/{voteId} {
      // A vote that doesn't exist yet (first vote) is readable by the voter whose uid prefixes its id.
      allow read: if signedIn() && (isAdmin() || (resource == null ? voteId.split('_')[0] == request.auth.uid : resource.data.uid == request.auth.uid));

      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'candidateId', 'season', 'ups', 'downs', 'weekAt', 'weekKind', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && voteId == request.auth.uid + '_' + request.resource.data.candidateId
        && request.resource.data.updatedAt == request.time
        && voteAction()
        && voteMatchesTally();

      allow delete: if (adminOp('deleteAccount') && (resource.data.uid == lock().payload.target || resource.data.candidateId == lock().payload.target));
    }

    // ---- deleted accounts ---------------------------------------------------------

    match /banned/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if adminOp('deleteAccount') && lock().payload.target == uid
        && request.resource.data.keys().hasOnly(['at', 'by'])
        && request.resource.data.at == request.time
        && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- messages -----------------------------------------------------------------
    // 메시지 끄기 (candidates/{uid}.msgOff) means: nobody can open a 1:1 with them or
    // put them in a new group, and nobody can send in a 1:1 with them; they can't
    // send either. A deleted account has no candidates doc, so get() fails → refused.

    function msgOn(uid) {
      return get(/databases/$(database)/documents/candidates/$(uid)).data.get('msgOff', false) != true;
    }
    function memberOn(m, i) { return m.size() <= i || msgOn(m[i]); }
    function membersOk(m) {
      return m is list && m.size() >= 2 && m.size() <= 10 && m.toSet().size() == m.size()
        && request.auth.uid in m
        && memberOn(m, 0) && memberOn(m, 1) && memberOn(m, 2) && memberOn(m, 3) && memberOn(m, 4)
        && memberOn(m, 5) && memberOn(m, 6) && memberOn(m, 7) && memberOn(m, 8) && memberOn(m, 9);
    }
    function dmOther(chat) { return chat.members[0] == request.auth.uid ? chat.members[1] : chat.members[0]; }
    function canSend(chat) {
      return request.auth.uid in chat.members && msgOn(request.auth.uid)
        && (chat.type != 'dm' || msgOn(dmOther(chat)));
    }
    function chatData(chatId) { return get(/databases/$(database)/documents/chats/$(chatId)).data; }

    match /chats/{chatId} {
      // A 1:1 chat id names its members, so checking whether it exists yet is allowed.
      allow get: if signedIn() && (resource == null
        ? request.auth.uid in chatId.split('_')
        : request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['type', 'members', 'name', 'createdBy', 'createdAt', 'updatedAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && membersOk(request.resource.data.members)
        && ((request.resource.data.type == 'dm'
              && request.resource.data.members.size() == 2
              && request.resource.data.name == ''
              && chatId == (request.resource.data.members[0] < request.resource.data.members[1]
                  ? request.resource.data.members[0] + '_' + request.resource.data.members[1]
                  : request.resource.data.members[1] + '_' + request.resource.data.members[0]))
          || (request.resource.data.type == 'group'
              && request.resource.data.members.size() >= 3
              && request.resource.data.name is string && request.resource.data.name.size() <= 30));

      allow update: if signedIn() && request.auth.uid in resource.data.members
        && (newMessageSummary() || readReceipt() || muteToggle() || leaveGroup() || addMembers() || groupInfo());
      allow delete: if false;

      function readsOk() {
        let d = request.resource.data;
        let o = resource.data;
        return !('reads' in d.diff(o).affectedKeys())
          || (d.reads.diff(o.get('reads', {})).affectedKeys().hasOnly([request.auth.uid])
              && d.reads[request.auth.uid] == request.time);
      }
      // Sending: the chat's last-message preview moves with the message written in the same batch.
      function newMessageSummary() {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys().hasOnly(['last', 'updatedAt', 'reads'])
          && d.last.keys().hasOnly(['text', 'uid', 'at'])
          && d.last.uid == request.auth.uid && d.last.at == request.time && d.updatedAt == request.time
          && d.last.text is string && d.last.text.size() >= 1 && d.last.text.size() <= 100
          && canSend(resource.data) && readsOk();
      }
      function readReceipt() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reads']) && readsOk();
      }
      // Per-chat 알림 on/off: each member flips only their own entry.
      function muteToggle() {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys().hasOnly(['mutes'])
          && d.mutes.diff(resource.data.get('mutes', {})).affectedKeys().hasOnly([request.auth.uid])
          && d.mutes[request.auth.uid] is bool;
      }
      // Inviting: only adds people (who accept messages), group stays ≤ 10.
      function addMembers() {
        let d = request.resource.data;
        let o = resource.data;
        let added = d.members.removeAll(o.members);
        return o.type == 'group'
          && d.diff(o).affectedKeys().hasOnly(['members'])
          && d.members.hasAll(o.members)
          && d.members.size() <= 10 && d.members.toSet().size() == d.members.size()
          && added.size() >= 1
          && memberOn(added, 0) && memberOn(added, 1) && memberOn(added, 2) && memberOn(added, 3) && memberOn(added, 4)
          && memberOn(added, 5) && memberOn(added, 6) && memberOn(added, 7) && memberOn(added, 8);
      }
      // Group icon (small JPEG) and name, editable by any member.
      function groupInfo() {
        let d = request.resource.data;
        return resource.data.type == 'group'
          && d.diff(resource.data).affectedKeys().hasOnly(['photo', 'name'])
          && d.get('photo', '') is string && d.get('photo', '').size() <= 200000
          && d.name is string && d.name.size() <= 30;
      }
      function leaveGroup() {
        return resource.data.type == 'group'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid]);
      }

      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in chatData(chatId).members;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'text', 'at', 'kind', 'giftId', 'replyTo'])
          // 답장: a short quote of an existing message in this chat
          && (!('replyTo' in request.resource.data)
              || (request.resource.data.replyTo.keys().hasOnly(['id', 'uid', 'text'])
                  && request.resource.data.replyTo.text is string && request.resource.data.replyTo.text.size() <= 100
                  && exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.replyTo.id))))
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.text is string && request.resource.data.text.size() <= 500
          && request.resource.data.get('kind', 'text') in ['text', 'image', 'system', 'gift']
          && (request.resource.data.get('kind', 'text') == 'image'
                ? existsAfter(/databases/$(database)/documents/chats/$(chatId)/media/$(msgId))
                : request.resource.data.text.size() >= 1)
          && (request.resource.data.get('kind', 'text') != 'gift'
                || (getAfter(/databases/$(database)/documents/gifts/$(request.resource.data.giftId)).data.from == request.auth.uid
                    && getAfter(/databases/$(database)/documents/gifts/$(request.resource.data.giftId)).data.chatId == chatId))
          && canSend(chatData(chatId));
        allow update, delete: if false;
      }

      // A photo message's image, written in the same batch as the message.
      match /media/{msgId} {
        allow read: if signedIn() && request.auth.uid in chatData(chatId).members;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'data', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 700000
          && request.resource.data.data.split(',')[0] in ['data:image/jpeg;base64', 'data:image/png;base64', 'data:image/webp;base64']
          && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(msgId)).data.uid == request.auth.uid
          && canSend(chatData(chatId));
        allow update, delete: if false;
      }
    }

    // ---- notifications ----------------------------------------------------------
    // Sent by .github/scripts/send-notifications.mjs with the service account
    // (rules don't apply to it). Clients only register their own device and
    // settings; nobody can read another person's tokens or settings.

    match /pushTokens/{token} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      // The doc id is the token itself, so holding the token (i.e. the device) is what lets you claim it.
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'token', 'platform', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token == token
        && token.size() <= 1024
        && request.resource.data.platform in ['web', 'android']
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /settings/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['notify', 'notifyMsg', 'notifyVote'])
        && request.resource.data.get('notify', true) is bool
        && request.resource.data.get('notifyMsg', true) is bool
        && request.resource.data.get('notifyVote', true) is bool;
      allow delete: if false;
    }

    // ---- 상담 (support) and password resets ---------------------------------------
    // Someone who forgot their password signs in anonymously and chats with the
    // admin. The admin can reset an account's password (3-token op): the worker
    // sets it to the one-time code, and the user picks a new one right after
    // logging in with it.

    match /support/{uid} {
      function supportText(t) { return t is string && t.size() >= 1 && t.size() <= 1000; }
      function asUser() { return request.auth.uid == uid; }
      allow read: if signedIn() && (asUser() || isAdmin());
      allow create: if signedIn() && asUser()
        && request.resource.data.keys().hasOnly(['loginId', 'name', 'createdAt', 'updatedAt', 'last', 'adminRead', 'userRead'])
        && request.resource.data.loginId is string && request.resource.data.loginId.size() <= 20
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.last.keys().hasOnly(['from', 'text', 'at'])
        && request.resource.data.last.from == 'user' && request.resource.data.last.at == request.time
        && supportText(request.resource.data.last.text);
      allow update: if signedIn() && (asUser() || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last', 'updatedAt', 'adminRead', 'userRead'])
        && (!('last' in request.resource.data.diff(resource.data).affectedKeys())
            || (request.resource.data.last.keys().hasOnly(['from', 'text', 'at'])
                && request.resource.data.last.at == request.time && request.resource.data.updatedAt == request.time
                && supportText(request.resource.data.last.text)
                && ((asUser() && request.resource.data.last.from == 'user') || (isAdmin() && request.resource.data.last.from == 'admin'))));
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['from', 'text', 'at'])
          && request.resource.data.at == request.time
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && ((request.auth.uid == uid && request.resource.data.from == 'user') || (isAdmin() && request.resource.data.from == 'admin'));
        allow update, delete: if false;
      }
    }

    match /pwResets/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if adminOp('resetPassword') && lock().payload.target == uid
        && request.resource.data.keys().hasOnly(['code', 'by', 'at', 'status'])
        && request.resource.data.code == lock().payload.code
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.status == 'pending';
      // After logging in with the code and choosing a new password.
      allow delete: if signedIn() && request.auth.uid == uid && resource.data.status == 'done';
    }

    // ---- 공지 (notices) ------------------------------------------------------------
    // Posted by the admin (3-token op). Real accounts only (not the anonymous 상담
    // login), and each person can read a notice once: after they mark it seen,
    // reading it is refused.

    function member() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function seenNotice(id) {
      let rp = /databases/$(database)/documents/noticeReads/$(request.auth.uid);
      return exists(rp) && get(rp).data.seen.get(id, false) == true;
    }

    match /notices/{id} {
      allow get: if isAdmin() || (member() && !seenNotice(id));
      allow list: if isAdmin();
      allow create: if adminOp('postNotice') && lock().payload.id == id
        && request.resource.data.keys().hasOnly(['title', 'body', 'by', 'createdAt'])
        && request.resource.data.title == lock().payload.title
        && request.resource.data.body == lock().payload.body
        && request.resource.data.by == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /meta/noticeIndex {
      allow read: if member() || isAdmin();
      allow write: if adminOp('postNotice')
        && request.resource.data.keys().hasOnly(['ids'])
        && request.resource.data.ids is list && request.resource.data.ids.size() <= 20
        && request.resource.data.ids[0] == lock().payload.id;
    }

    match /noticeReads/{uid} {
      allow read: if member() && request.auth.uid == uid;
      allow create: if member() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['seen']) && request.resource.data.seen is map;
      allow update: if member() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['seen'])
        && request.resource.data.seen.keys().hasAll(resource.data.seen.keys())
        && request.resource.data.seen.diff(resource.data.seen).affectedKeys().hasOnly(request.resource.data.seen.diff(resource.data.seen).addedKeys());
      allow delete: if false;
    }

    // ---- season results -------------------------------------------------------------
    match /seasonResults/{n} {
      allow read: if true;
      allow create: if adminOp('seasonReset');
      allow update, delete: if false;
    }

    // ---- 포인트 선물 (gifts) ----------------------------------------------------------
    match /gifts/{id} {
      function inChat(chatId) { return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members; }
      function me() { return /databases/$(database)/documents/candidates/$(request.auth.uid); }
      // A gift that doesn't exist yet reveals nothing; the chat can start watching it before the send lands.
      allow read: if signedIn() && (resource == null || inChat(resource.data.chatId));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['chatId', 'from', 'to', 'amount', 'status', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.amount is int && request.resource.data.amount >= 1 && request.resource.data.amount <= 100000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && canSend(get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data)
        && (get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.type == 'dm'
              ? request.resource.data.to == dmOther(get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data)
              : request.resource.data.to == null)
        // the points are held in the same write
        && getAfter(me()).data.get('lastGift', '') == id
        && getAfter(me()).data.spent == get(me()).data.spent + request.resource.data.amount;
      allow update: if signedIn() && resource.data.status == 'open' && (
        // 받기: someone else in the chat (the addressee in a 1:1), first come first served
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedBy', 'doneAt'])
          && request.resource.data.status == 'claimed' && request.resource.data.claimedBy == request.auth.uid
          && request.resource.data.doneAt == request.time
          && request.auth.uid != resource.data.from
          && (resource.data.to == null || resource.data.to == request.auth.uid)
          && inChat(resource.data.chatId)
          && getAfter(me()).data.get('lastGift', '') == id
          && getAfter(me()).data.get('bonus', 0) == get(me()).data.get('bonus', 0) + resource.data.amount) ||
        // 취소: the sender, while nobody has taken it
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneAt'])
          && request.resource.data.status == 'cancelled' && request.resource.data.doneAt == request.time
          && request.auth.uid == resource.data.from
          && getAfter(me()).data.get('lastGift', '') == id
          && getAfter(me()).data.spent == get(me()).data.spent - resource.data.amount)
      );
      allow delete: if false;
    }
  }
}
