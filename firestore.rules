rules_version = '2';

// Auto-deployed by .github/workflows/firebase-backend.yml on every push to main
// that touches this file, after tests/rules passes against the emulator.
//
// Data model
//   candidates/{uid}              a signed-up user's leaderboard entry (doc id == Auth uid)
//   votes/{voterUid}_{candidateId} one voter's history with one candidate:
//                                 { season, ups (this season), lastUpAt, down, downSeason }
//                                 추천 once every 7 days (adds up), 비추천 once ever; neither can be undone
//   meta/season                   { name, number, startedAt, last? }  last = the ended season's { name, top: [≤3 × {id,name,score,frame}] }
//   meta/adminLock                the admin operation currently being committed (see below)
//   adminTokens/{random id}       single-use tokens for admin operations
//   banned/{uid}                  accounts deleted by the admin; they can't re-join
//   chats/{chatId}                1:1 (id = sorted uids joined by '_') or group chat (≤10 members);
//                                 reads/mutes maps hold each member's read time / 알림 off
//   chats/{chatId}/messages/{id}  { uid, text, at }
//
// Admin operations (grant points, set season name, reset season, delete account)
// Only the admin account (id "admin", i.e. admin@vote.local, or a user with the
// `admin` custom claim that only a service account can set) may run them, and
// every batch of writes must:
//   1. burn three fresh single-use tokens (seq 1, 2, 3) that the admin created
//      within the last 2 minutes for exactly this action + payload, and
//   2. write meta/adminLock with those token ids in the same batch.
// The lock rule checks the three tokens; every privileged write checks that the
// lock was written in this very request (lock.at == request.time) for its action.
// A token can't be reused (used only goes false → true, never deleted), so
// replaying or tampering with a request fails.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (request.auth.token.email == 'admin@vote.local' || request.auth.token.get('admin', false) == true);
    }

    // ---- admin operation plumbing -------------------------------------------------

    function lockPath() { return /databases/$(database)/documents/meta/adminLock; }
    function lock() { return getAfter(lockPath()).data; }
    // True only inside the batch that just wrote a valid meta/adminLock for `action`.
    function adminOp(action) {
      return isAdmin() && lock().at == request.time && lock().by == request.auth.uid && lock().action == action;
    }

    function validPersonName(n) { return n is string && n.size() >= 1 && n.size() <= 20; }

    function validPayload(action, p) {
      return (action == 'grantPoints' && p.keys().hasOnly(['target', 'amount']) && p.keys().hasAll(['target', 'amount'])
                && p.target is string && p.amount is int && p.amount != 0 && p.amount >= -1000000 && p.amount <= 1000000)
          || (action == 'setSeasonName' && p.keys().hasOnly(['name']) && validSeasonName(p.name))
          || (action == 'seasonReset' && p.keys().hasOnly(['name', 'nextNumber']) && p.keys().hasAll(['name', 'nextNumber'])
                && validSeasonName(p.name) && p.nextNumber is int)
          || (action == 'renameUser' && p.keys().hasOnly(['target', 'name']) && p.keys().hasAll(['target', 'name'])
                && p.target is string && validPersonName(p.name))
          || (action == 'deleteAccount' && p.keys().hasOnly(['target']) && p.target is string && p.target != request.auth.uid);
    }
    function validSeasonName(n) { return n is string && n.size() >= 1 && n.size() <= 20; }

    function tokenOk(id, seq) {
      let p = /databases/$(database)/documents/adminTokens/$(id);
      let before = get(p).data;
      let l = request.resource.data;
      return before.used == false && getAfter(p).data.used == true
        && before.uid == request.auth.uid && before.seq == seq
        && before.action == l.action && before.payload == l.payload
        && request.time < before.createdAt + duration.value(120, 's');
    }

    match /meta/adminLock {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['by', 'action', 'payload', 'tokens', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.tokens is list && request.resource.data.tokens.size() == 3
        && validPayload(request.resource.data.action, request.resource.data.payload)
        && tokenOk(request.resource.data.tokens[0], 1)
        && tokenOk(request.resource.data.tokens[1], 2)
        && tokenOk(request.resource.data.tokens[2], 3);
      allow delete: if false;
    }

    match /adminTokens/{tokenId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && tokenId.size() >= 32
        && request.resource.data.keys().hasOnly(['uid', 'action', 'payload', 'seq', 'used', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.used == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.seq in [1, 2, 3]
        && request.resource.data.action in ['grantPoints', 'setSeasonName', 'seasonReset', 'deleteAccount', 'renameUser']
        && request.resource.data.payload is map;
      // Burned only together with a lock that lists it.
      allow update: if isAdmin()
        && resource.data.uid == request.auth.uid
        && resource.data.used == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
        && request.resource.data.used == true
        && lock().at == request.time
        && tokenId in lock().tokens;
      allow delete: if false;
    }

    // ---- season -------------------------------------------------------------------

    // The ended season's podium, recorded by the reset so the app can show it once.
    function lastOk(last, endedName) {
      return last == null || (last is map && last.keys().hasOnly(['name', 'top']) && last.name == endedName
        && last.top is list && last.top.size() <= 3);
    }

    match /meta/season {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['name', 'number', 'startedAt', 'last']) && (
        (adminOp('setSeasonName')
          && request.resource.data.name == lock().payload.name
          && request.resource.data.get('last', null) == (resource == null ? null : resource.data.get('last', null))
          && (resource == null
                ? request.resource.data.number == 1 && request.resource.data.startedAt == request.time
                : request.resource.data.number == resource.data.number && request.resource.data.startedAt == resource.data.startedAt)) ||
        (adminOp('seasonReset')
          && request.resource.data.name == lock().payload.name
          && request.resource.data.number == lock().payload.nextNumber
          && lock().payload.nextNumber == (resource == null ? 1 : resource.data.number) + 1
          && request.resource.data.startedAt == request.time
          && lastOk(request.resource.data.get('last', null), resource == null ? 'BETA' : resource.data.name))
      );
    }

    // ---- candidates ---------------------------------------------------------------

    function photoOk(d) { return d.photoURL is string && d.photoURL.size() < 300000; }

    function price(kind, k) {
      let frame = {'neon': 120, 'crown': 180, 'sakura': 100, 'cat': 100, 'stars': 140, 'flame': 160, 'ocean': 120, 'bunny': 100, 'halo': 150, 'devil': 150, 'butterfly': 120};
      let skin = {'namsan': 200, 'eiffel': 250, 'bigben': 250, 'victory': 220};
      return kind == 'frame' ? frame.get(k, 0) : kind == 'plate' ? frame.get(k, 0) + 30 : skin.get(k, 0);
    }
    function buyable(kind, added) {
      let frameKeys = ['neon', 'crown', 'sakura', 'cat', 'stars', 'flame', 'ocean', 'bunny', 'halo', 'devil', 'butterfly'];
      let skinKeys = ['namsan', 'eiffel', 'bigben', 'victory'];
      return added.size() == 0 || (added.size() == 1 && added[0] in (kind == 'skin' ? skinKeys : frameKeys));
    }
    function costOf(kind, added) { return added.size() == 1 ? price(kind, added[0]) : 0; }

    // Owner editing their own profile, equipping, or buying one item at its real price.
    function ownerEdit() {
      let d = request.resource.data;
      let o = resource.data;
      let addF = d.owned.frame.removeAll(o.owned.frame);
      let addP = d.owned.plate.removeAll(o.owned.plate);
      let addS = d.owned.skin.removeAll(o.owned.skin);
      let cost = costOf('frame', addF) + costOf('plate', addP) + costOf('skin', addS);
      return request.auth.uid == o.ownerUid
        && d.diff(o).affectedKeys().hasOnly(['gender', 'bio', 'photoURL', 'frame', 'plate', 'skin', 'spent', 'owned', 'msgOff'])
        && d.owned.keys().hasOnly(['frame', 'plate', 'skin'])
        && d.owned.frame.hasAll(o.owned.frame) && d.owned.plate.hasAll(o.owned.plate) && d.owned.skin.hasAll(o.owned.skin)
        && addF.size() + addP.size() + addS.size() <= 1
        && buyable('frame', addF) && buyable('plate', addP) && buyable('skin', addS)
        && d.spent == o.spent + cost
        && (cost == 0 || d.spent <= d.up + d.get('bonus', 0))
        && d.frame in d.owned.frame && d.plate in d.owned.plate && d.skin in d.owned.skin
        && d.bio is string && d.bio.size() <= 60
        && d.gender in ['', '남자', '여자']
        && d.get('msgOff', false) is bool
        && photoOk(d);
    }

    // ---- vote bookkeeping ----
    // A vote doc counts toward the tally only for the season it was last updated in;
    // a season reset zeroes the tallies but keeps the docs (so the 7-day timer and the
    // one-time 비추천 carry over).
    function curSeason() {
      let sp = /databases/$(database)/documents/meta/season;
      return exists(sp) ? get(sp).data.number : 1;
    }
    function upsNow(v, cur) { return v.get('season', 0) == cur ? v.get('ups', 0) : 0; }
    function downNow(v, cur) { return v.get('down', false) == true && v.get('downSeason', 0) == cur ? 1 : 0; }

    // Another user's vote moving the tally — must match their vote doc changing in the same write.
    function voteTally(candidateId) {
      let d = request.resource.data;
      let o = resource.data;
      let vp = /databases/$(database)/documents/votes/$(request.auth.uid + '_' + candidateId);
      let before = exists(vp) ? get(vp).data : {};
      let cur = curSeason();
      return request.auth.uid != o.ownerUid
        && existsAfter(vp)
        && d.diff(o).affectedKeys().hasOnly(['up', 'down', 'score'])
        && d.up == o.up + upsNow(getAfter(vp).data, cur) - upsNow(before, cur)
        && d.down == o.down + downNow(getAfter(vp).data, cur) - downNow(before, cur)
        && (d.up != o.up || d.down != o.down)
        && d.score == d.up - d.down;
    }

    function adminGrant(candidateId) {
      let d = request.resource.data;
      return adminOp('grantPoints') && lock().payload.target == candidateId
        && d.diff(resource.data).affectedKeys().hasOnly(['bonus'])
        && d.bonus == resource.data.get('bonus', 0) + lock().payload.amount;
    }

    function adminRename(candidateId) {
      let d = request.resource.data;
      return adminOp('renameUser') && lock().payload.target == candidateId
        && d.diff(resource.data).affectedKeys().hasOnly(['name'])
        && d.name == lock().payload.name;
    }

    // Season reset: tallies to zero; this season's recommendations carry over as points (bonus).
    function adminSeasonReset() {
      let d = request.resource.data;
      let o = resource.data;
      return adminOp('seasonReset')
        && d.diff(o).affectedKeys().hasOnly(['up', 'down', 'score', 'bonus'])
        && d.up == 0 && d.down == 0 && d.score == 0
        && d.get('bonus', 0) == o.get('bonus', 0) + o.up;
    }

    // Deleting account T: take back T's vote on this candidate, deleting that vote doc in the same batch.
    function adminDeleteAdjust(candidateId) {
      let d = request.resource.data;
      let o = resource.data;
      let target = lock().payload.target;
      let vp = /databases/$(database)/documents/votes/$(target + '_' + candidateId);
      let v = get(vp).data;
      let cur = curSeason();
      return adminOp('deleteAccount') && candidateId != target
        && !existsAfter(vp)
        && d.diff(o).affectedKeys().hasOnly(['up', 'down', 'score'])
        && d.up == o.up - upsNow(v, cur)
        && d.down == o.down - downNow(v, cur)
        && d.score == d.up - d.down;
    }

    match /candidates/{candidateId} {
      allow read: if true;

      allow create: if signedIn()
        && request.auth.uid == candidateId
        && !exists(/databases/$(database)/documents/banned/$(candidateId))
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'up', 'down', 'score', 'gender', 'bio', 'photoURL', 'frame', 'plate', 'skin', 'spent', 'owned', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 20
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.up == 0 && request.resource.data.down == 0 && request.resource.data.score == 0
        && request.resource.data.spent == 0
        && request.resource.data.gender == '' && request.resource.data.bio == '' && request.resource.data.photoURL == ''
        && request.resource.data.frame == 'none' && request.resource.data.plate == 'none' && request.resource.data.skin == 'none'
        && request.resource.data.owned == {'frame': ['none'], 'plate': ['none'], 'skin': ['none']};

      allow update: if signedIn() && (
        ownerEdit() || voteTally(candidateId) ||
        adminGrant(candidateId) || adminRename(candidateId) || adminSeasonReset() || adminDeleteAdjust(candidateId)
      );

      allow delete: if adminOp('deleteAccount') && lock().payload.target == candidateId;
    }

    // ---- votes --------------------------------------------------------------------

    // The vote doc may only change together with the matching tally change on the candidate.
    function voteMatchesTally() {
      let cp = /databases/$(database)/documents/candidates/$(request.resource.data.candidateId);
      let c0 = get(cp).data;
      let c1 = getAfter(cp).data;
      let o = resource == null ? {} : resource.data;
      let cur = curSeason();
      return c0.ownerUid != request.auth.uid
        && c1.up == c0.up + upsNow(request.resource.data, cur) - upsNow(o, cur)
        && c1.down == c0.down + downNow(request.resource.data, cur) - downNow(o, cur);
    }

    // 추천: once every 7 days per person, adding up. 비추천: once ever per person. Neither undoes.
    function voteAction() {
      let d = request.resource.data;
      let o = resource == null ? {} : resource.data;
      let cur = curSeason();
      let oUps = upsNow(o, cur);
      let oLast = o.get('lastUpAt', null);
      let oDown = o.get('down', false);
      let oDownSeason = o.get('downSeason', 0);
      return d.season == cur && d.ups is int && d.down is bool && d.downSeason is int
        && ((d.ups == oUps + 1 && d.lastUpAt == request.time
              && (oLast == null || request.time >= oLast + duration.value(7, 'd'))
              && d.down == oDown && d.downSeason == oDownSeason)
          || (oDown == false && d.down == true && d.downSeason == cur
              && d.ups == oUps && d.lastUpAt == oLast));
    }

    match /votes/{voteId} {
      // A vote that doesn't exist yet (first vote) is readable by the voter whose uid prefixes its id.
      allow read: if signedIn() && (isAdmin() || (resource == null ? voteId.split('_')[0] == request.auth.uid : resource.data.uid == request.auth.uid));

      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'candidateId', 'season', 'ups', 'lastUpAt', 'down', 'downSeason', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && voteId == request.auth.uid + '_' + request.resource.data.candidateId
        && request.resource.data.updatedAt == request.time
        && voteAction()
        && voteMatchesTally();

      allow delete: if (adminOp('deleteAccount') && (resource.data.uid == lock().payload.target || resource.data.candidateId == lock().payload.target));
    }

    // ---- deleted accounts ---------------------------------------------------------

    match /banned/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if adminOp('deleteAccount') && lock().payload.target == uid
        && request.resource.data.keys().hasOnly(['at', 'by'])
        && request.resource.data.at == request.time
        && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- messages -----------------------------------------------------------------
    // 메시지 끄기 (candidates/{uid}.msgOff) means: nobody can open a 1:1 with them or
    // put them in a new group, and nobody can send in a 1:1 with them; they can't
    // send either. A deleted account has no candidates doc, so get() fails → refused.

    function msgOn(uid) {
      return get(/databases/$(database)/documents/candidates/$(uid)).data.get('msgOff', false) != true;
    }
    function memberOn(m, i) { return m.size() <= i || msgOn(m[i]); }
    function membersOk(m) {
      return m is list && m.size() >= 2 && m.size() <= 10 && m.toSet().size() == m.size()
        && request.auth.uid in m
        && memberOn(m, 0) && memberOn(m, 1) && memberOn(m, 2) && memberOn(m, 3) && memberOn(m, 4)
        && memberOn(m, 5) && memberOn(m, 6) && memberOn(m, 7) && memberOn(m, 8) && memberOn(m, 9);
    }
    function dmOther(chat) { return chat.members[0] == request.auth.uid ? chat.members[1] : chat.members[0]; }
    function canSend(chat) {
      return request.auth.uid in chat.members && msgOn(request.auth.uid)
        && (chat.type != 'dm' || msgOn(dmOther(chat)));
    }
    function chatData(chatId) { return get(/databases/$(database)/documents/chats/$(chatId)).data; }

    match /chats/{chatId} {
      // A 1:1 chat id names its members, so checking whether it exists yet is allowed.
      allow get: if signedIn() && (resource == null
        ? request.auth.uid in chatId.split('_')
        : request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['type', 'members', 'name', 'createdBy', 'createdAt', 'updatedAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && membersOk(request.resource.data.members)
        && ((request.resource.data.type == 'dm'
              && request.resource.data.members.size() == 2
              && request.resource.data.name == ''
              && chatId == (request.resource.data.members[0] < request.resource.data.members[1]
                  ? request.resource.data.members[0] + '_' + request.resource.data.members[1]
                  : request.resource.data.members[1] + '_' + request.resource.data.members[0]))
          || (request.resource.data.type == 'group'
              && request.resource.data.members.size() >= 3
              && request.resource.data.name is string && request.resource.data.name.size() <= 30));

      allow update: if signedIn() && request.auth.uid in resource.data.members
        && (newMessageSummary() || readReceipt() || muteToggle() || leaveGroup());
      allow delete: if false;

      function readsOk() {
        let d = request.resource.data;
        let o = resource.data;
        return !('reads' in d.diff(o).affectedKeys())
          || (d.reads.diff(o.get('reads', {})).affectedKeys().hasOnly([request.auth.uid])
              && d.reads[request.auth.uid] == request.time);
      }
      // Sending: the chat's last-message preview moves with the message written in the same batch.
      function newMessageSummary() {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys().hasOnly(['last', 'updatedAt', 'reads'])
          && d.last.keys().hasOnly(['text', 'uid', 'at'])
          && d.last.uid == request.auth.uid && d.last.at == request.time && d.updatedAt == request.time
          && d.last.text is string && d.last.text.size() >= 1 && d.last.text.size() <= 100
          && canSend(resource.data) && readsOk();
      }
      function readReceipt() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reads']) && readsOk();
      }
      // Per-chat 알림 on/off: each member flips only their own entry.
      function muteToggle() {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys().hasOnly(['mutes'])
          && d.mutes.diff(resource.data.get('mutes', {})).affectedKeys().hasOnly([request.auth.uid])
          && d.mutes[request.auth.uid] is bool;
      }
      function leaveGroup() {
        return resource.data.type == 'group'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid]);
      }

      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in chatData(chatId).members;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'text', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
          && canSend(chatData(chatId));
        allow update, delete: if false;
      }
    }
  }
}
