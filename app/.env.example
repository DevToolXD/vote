# Firebase Web app config — from Firebase Console → Project settings → Your apps → SDK setup and config.
# These are public client identifiers, not secrets; it's normal for them to end up in the built bundle.
# Copy this file to .env.local (git-ignored) for local dev, and set the same names as repo
# variables/secrets so the GitHub Actions workflow can inject them at build time (see app/README.md).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
